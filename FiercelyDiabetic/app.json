{
  "expo": {
    "name": "FiercelyDiabetic",
    "slug": "fiercelydiabetic",
    "version": "1.0.0",
    "scheme": "fiercelydiabetic",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "com.fiercelydiabetic.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.fiercelydiabetic.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
